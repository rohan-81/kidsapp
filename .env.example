# KidsZone Environment Configuration Example
# Copy this file to .env and adjust values for your local environment

# Mobile API Configuration (Leave blank or set to your machine's LAN IP for physical device testing)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Django Backend Configuration
DJANGO_SECRET_KEY=kidszone-insecure-dev-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,*
CORS_ALLOW_ALL_ORIGINS=True
